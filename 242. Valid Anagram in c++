class Solution {
public:
    bool isAnagram(string s, string t) {
        vector<int> freq(26,0);
        vector <int> freq1(26,0);
        for (int ch:s)
        {
            freq[ch-'a']++;
        }
        for (int ch:t)
        {
            freq1[ch-'a']++;
        }
        for(int i=0;i<26;i++)
        {
            if (freq[i]!=freq1[i])
            {
                return false;
            }
        }
        return true;
    }
};
